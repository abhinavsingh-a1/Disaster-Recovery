project_name   = "shop-dr"
primary_region = "eu-central-1"
dr_mode        = "cross-region"
dr_region      = "eu-west-1"

protected_servers = {
  web-1 = { instance_type = "t3.medium", az_index = 0, root_volume_size = 30 }
  web-2 = { instance_type = "t3.medium", az_index = 1, root_volume_size = 30 }
}

replication_server_instance_type = "t3.small"
recovery_instance_type           = "t3.medium"
snapshot_retention_days          = 14

dr_enable_nat_gateway   = false
dr_enable_vpc_endpoints = true # no internet path from staging/recovery subnets

enable_database        = true
db_instance_class      = "db.t4g.medium"
db_multi_az            = true
db_deletion_protection = true

backup_retention_days  = 35
backup_vault_lock_mode = "compliance" # immutable after grace period - read docs/SECURITY.md first

alert_emails = ["oncall@example.com"]

hosted_zone_id        = "Z0123456789ABCDEFGHIJ"
dns_record_name       = "shop.example.com"
certificate_arn_primary = "arn:aws:acm:eu-central-1:123456789012:certificate/xxxx"
certificate_arn_dr      = "arn:aws:acm:eu-west-1:123456789012:certificate/yyyy"
auto_recovery_enabled = false # keep a human in the loop until drills are routine
